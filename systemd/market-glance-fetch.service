[Unit]
Description=Market Glance market-data fetcher to JSON
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
# The installer renders @APP_DIR@ from this checkout's actual location.
Environment=no_proxy=localhost,127.0.0.1,::1,[::1],198.19.0.1,198.19.0.2
Environment=NO_PROXY=localhost,127.0.0.1,::1,[::1],198.19.0.1,198.19.0.2
EnvironmentFile=-/etc/default/market-glance-fetch
ExecStart=/usr/bin/python3 @APP_DIR@/fetch.py
StandardOutput=journal
StandardError=journal
