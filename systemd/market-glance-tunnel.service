[Unit]
Description=Optional Market Glance SSH reverse tunnel
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
EnvironmentFile=-/etc/default/market-glance-tunnel
ExecStart=@APP_DIR@/tunnel.sh
Restart=on-failure
RestartSec=15
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
